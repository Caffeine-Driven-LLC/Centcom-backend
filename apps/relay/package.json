  "dependencies": {
    "@centcom/contracts": "workspace:*",
    "@centcom/core": "workspace:*",
    "@centcom/db": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "jose": "6.2.12",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@types/ws": "8.18.2"
  }
