{
  "name": "@centcom/relay",
  "version": "0.0.0",
  "private": true,
  "description": "WebSocket relay: sessions, sequencing, queue, presence, control. Routes ciphertext only.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
