{
  "name": "@centcom/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Types, validators and helpers generated from contracts/.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-validators.mjs",
    "build:assets": "node scripts/copy-validators.mjs",
    "contracts:gen": "tsx scripts/generate.ts",
    "contracts:check": "tsx scripts/generate.ts --check"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  }
}
