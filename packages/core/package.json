{
  "name": "@centcom/core",
  "version": "0.0.0",
  "private": true,
  "description": "Config, logging, errors, RBAC, rate limiting, Redis and email primitives.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entitlements": {
      "types": "./dist/entitlements/index.d.ts",
      "default": "./dist/entitlements/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "gen:config-docs": "tsx scripts/gen-config-docs.ts",
    "gen:slo-rules": "tsx scripts/gen-slo-rules.ts"
  },
  "dependencies": {
    "@centcom/contracts": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "ioredis": "6.0.0",
    "kysely": "0.29.6",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  }
}
