{
  "name": "@centcom/storage",
  "version": "0.0.0",
  "private": true,
  "description": "Object storage (S3-compatible, SigV4) and the durable session history log, shared by the API and the relay.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@centcom/contracts": "workspace:*",
    "@centcom/core": "workspace:*",
    "@centcom/db": "workspace:*",
    "kysely": "0.29.6"
  }
}
