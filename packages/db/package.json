{
  "name": "@centcom/db",
  "version": "0.0.0",
  "private": true,
  "description": "Postgres client (Kysely) and plain SQL migrations.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "centcom-db": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "migrate": "node dist/cli.js migrate",
    "migrate:status": "node dist/cli.js status",
    "migrate:new": "node dist/cli.js new"
  },
  "dependencies": {
    "@centcom/contracts": "workspace:*",
    "@centcom/core": "workspace:*",
    "kysely": "0.29.6",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
