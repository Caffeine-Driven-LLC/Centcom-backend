# Centcom production settings for the one-box stack (B091). Names and placeholders only.
#
#   node infra/deploy/gen-env.mjs            # writes production.env (mode 0600) from this file:
#                                            #   GENERATE:* lines get random values, you fill CHANGE_ME
#   Never commit production.env (infra/deploy/.gitignore lists it) and keep a copy in a password
#   manager. BACKUP_PASSPHRASE is the only way to read your backups: lose it and they are noise.
#
# deploy.sh refuses to run while any GENERATE: or CHANGE_ME is left. Values are in the shell
# `KEY=value` form compose reads; wrap a value that has spaces or JSON in single quotes.

# ---- Where it lives -------------------------------------------------------------------------
# Public host names. Create proxied (orange cloud) A/AAAA records for both pointing at the server.
# API_HOST: e.g. api.example.com
API_HOST=CHANGE_ME
# RELAY_HOST: e.g. relay.example.com
RELAY_HOST=CHANGE_ME
# PUBLIC_API_URL: https://api.example.com (no trailing slash)
PUBLIC_API_URL=CHANGE_ME
# RELAY_PUBLIC_URL: wss://relay.example.com/v1/ws
RELAY_PUBLIC_URL=CHANGE_ME
# WEB_BASE_URL: https://centcom.dev: where join/invite/billing links point
WEB_BASE_URL=CHANGE_ME
# LOGIN_RETURN_TO_ALLOWLIST: comma-separated exact URLs a sign-in may return to, e.g. https://api.example.com/device
LOGIN_RETURN_TO_ALLOWLIST=CHANGE_ME
# RELAY_ALLOWED_ORIGINS: browser origins allowed to open a WebSocket; empty: native clients only
RELAY_ALLOWED_ORIGINS=
# ACME_EMAIL: Let's Encrypt contact for certificate expiry notices
ACME_EMAIL=CHANGE_ME
RELAY_REGION=eu
# Published ports. Leave at 80/443 on the real server.
HTTP_PORT=80
HTTPS_PORT=443

# ---- Secrets generated for you (GENERATE:<kind>) ---------------------------------------------
# Each is read by the services named in brackets and by nothing else (docker-compose.prod.yml).
# POSTGRES_PASSWORD: [postgres, api, worker, relay, migrate] database login
POSTGRES_PASSWORD=GENERATE:hex
# REDIS_PASSWORD: [redis, api, worker, relay] queue/rate-limit/idempotency store
REDIS_PASSWORD=GENERATE:hex
# Signs access tokens and relay tickets (Ed25519 JWK set). The relay verifies them through
# GET /.well-known/jwks.json. To rotate: add a second key to the list, point AUTH_SIGNING_KID at it.
# AUTH_SIGNING_KEYS: [api, worker]
AUTH_SIGNING_KEYS=GENERATE:ed25519-jwk-set
# AUTH_SIGNING_KID: [api, worker] which key signs
AUTH_SIGNING_KID=GENERATE:kid
# IDEMPOTENCY_ENCRYPTION_KEY: [api, worker] encrypts stored replies (invite tokens)
IDEMPOTENCY_ENCRYPTION_KEY=GENERATE:base64-32
# CURSOR_SIGNING_KEYS: [api, worker] signs list cursors, `id:secret` (>= 32 chars)
CURSOR_SIGNING_KEYS=GENERATE:cursor-keys
# Object store login: MinIO's root user and password (the bundled store), or the access key and
# secret of a Cloudflare R2 / Backblaze B2 / S3 bucket if you switch to one.
# OBJECT_STORE_ACCESS_KEY_ID: [minio, api, worker, relay]
OBJECT_STORE_ACCESS_KEY_ID=GENERATE:access-key
# OBJECT_STORE_SECRET_ACCESS_KEY: [minio, api, worker, relay]
OBJECT_STORE_SECRET_ACCESS_KEY=GENERATE:hex
# Encrypts backups before they leave the server (backup scripts, B099). Not read by any service.
BACKUP_PASSPHRASE=GENERATE:hex

# ---- Mail -------------------------------------------------------------------------------------
# Sender of every mail. The domain must be verified at your mail provider (SPF/DKIM).
# EMAIL_FROM: Centcom <no-reply@example.com>
EMAIL_FROM=CHANGE_ME
# EMAIL_PROVIDER picks who delivers sign-in codes and invites (docs/ops/mail.md):
#   console   only logs the template; e-mail sign-in stays OFF (nobody can sign in)
#   resend    https://resend.com, set RESEND_API_KEY
#   brevo     https://brevo.com, set BREVO_API_KEY
#   postmark  https://postmarkapp.com, set POSTMARK_SERVER_TOKEN
#   smtp      any SMTP server, set SMTP_HOST (and SMTP_USER + SMTP_PASSWORD, SMTP_PORT, SMTP_SECURE)
# Setting a real provider turns e-mail sign-in and invites on. Fill in only the matching key.
EMAIL_PROVIDER=console
# RESEND_API_KEY: secret [api, worker]
RESEND_API_KEY=
# BREVO_API_KEY: secret [api, worker]
BREVO_API_KEY=
# POSTMARK_SERVER_TOKEN: secret [api, worker]
POSTMARK_SERVER_TOKEN=
# SMTP: SMTP_SECURE is starttls (port 587, default), tls (port 465) or none (a trusted local relay only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=starttls
# SMTP_ALLOW_CLEARTEXT_AUTH: only to send the password unencrypted to a host that is not this machine (SMTP_SECURE=none); keep false
SMTP_ALLOW_CLEARTEXT_AUTH=false
SMTP_USER=
# SMTP_PASSWORD: secret [api, worker]
SMTP_PASSWORD=

# ---- Billing ----------------------------------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to run WITHOUT billing (self-hosting): the billing routes are left
# out and every new personal workspace starts on SELF_HOST_PLAN (free, pro or team; empty = free).
# Setting STRIPE_SECRET_KEY turns billing on and then requires the webhook secret and all twelve
# prices below; SELF_HOST_PLAN must then stay empty. Steps: docs/billing/going-live.md
# SELF_HOST_PLAN: free | pro | team
SELF_HOST_PLAN=
# STRIPE_SECRET_KEY: secret [api, worker]; sk_live_... (or a restricted key rk_live_...)
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: secret [api, worker]; whsec_... of the endpoint https://<api host>/internal/stripe/webhook
STRIPE_WEBHOOK_SECRET=
BILLING_MAX_SEATS=500
STRIPE_PRICE_PRO_MONTH_USD=
STRIPE_PRICE_TEAM_MONTH_USD=
STRIPE_PRICE_SEAT_MONTH_USD=
STRIPE_PRICE_PRO_MONTH_EUR=
STRIPE_PRICE_TEAM_MONTH_EUR=
STRIPE_PRICE_SEAT_MONTH_EUR=
STRIPE_PRICE_PRO_YEAR_USD=
STRIPE_PRICE_TEAM_YEAR_USD=
STRIPE_PRICE_SEAT_YEAR_USD=
STRIPE_PRICE_PRO_YEAR_EUR=
STRIPE_PRICE_TEAM_YEAR_EUR=
STRIPE_PRICE_SEAT_YEAR_EUR=

# ---- Optional ---------------------------------------------------------------------------------
LOG_LEVEL=info
# RATELIMIT_AUTH_LIMIT: requests/min per client address to /v1/auth/*
RATELIMIT_AUTH_LIMIT=20
RATELIMIT_ANONYMOUS_LIMIT=30
# RELAY_MAX_CONNECTIONS: per relay process; see docs/ops/capacity.md
RELAY_MAX_CONNECTIONS=5000
# PG_SHARED_BUFFERS: about a quarter of the memory you give Postgres
PG_SHARED_BUFFERS=256MB
# Where backups go (B099): any S3-compatible bucket. Used by backup.sh, never by the services.
# BACKUP_S3_ENDPOINT: https://<account>.r2.cloudflarestorage.com or https://s3.<region>.backblazeb2.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
# BACKUP_S3_REGION: the signing region: auto for Cloudflare R2, the region name (such as us-west-004) for Backblaze B2
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
