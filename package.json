{
  "name": "centcom-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Centcom backend: REST API, WebSocket relay, workers, admin and shared packages.",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -b && pnpm -r --if-present run build:assets",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint . && node tools/repo/check-exact-pins.mjs",
    "test": "vitest run --config vitest.workspace.ts",
    "format": "prettier --write .",
    "contracts:gen": "pnpm --filter @centcom/contracts run contracts:gen",
    "contracts:check": "pnpm --filter @centcom/contracts run contracts:check",
    "dev:up": "bash tools/dev/up.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
