{
  "name": "centcom-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Centcom backend: REST API, WebSocket relay, workers, admin and shared packages.",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -b && pnpm -r --if-present run build:assets",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p apps/admin/tsconfig.test.json",
    "lint": "eslint . && node tools/repo/check-exact-pins.mjs",
    "test": "vitest run --config vitest.workspace.ts",
    "format": "prettier --write .",
    "contracts:gen": "pnpm --filter @centcom/contracts run contracts:gen",
    "contracts:check": "pnpm --filter @centcom/contracts run contracts:check",
    "dev:up": "bash tools/dev/up.sh",
    "dev:down": "bash tools/dev/down.sh",
    "dev:reset": "bash tools/dev/reset.sh",
    "dev:seed": "tsx --tsconfig tsconfig.test.json tools/dev/seed.ts",
    "dev:api": "tsx --tsconfig tsconfig.test.json tools/dev/api.ts",
    "dev:token": "tsx --tsconfig tsconfig.test.json tools/dev/token.ts",
    "dev:two-clients": "tsx --tsconfig tsconfig.test.json tools/dev/two-clients.ts",
    "dev:two-accounts": "tsx --tsconfig tsconfig.test.json tools/dev/two-accounts.ts",
    "dev:relay": "tsx --tsconfig tsconfig.test.json tools/dev/relay.ts",
    "release:publish": "tsx --tsconfig tsconfig.test.json apps/api/scripts/publish-release.ts",
    "security:deps": "node infra/security/check-deps.mjs",
    "security:licenses": "node infra/security/check-licenses.mjs",
    "security:secrets": "node infra/security/scan-secrets.mjs",
    "security:sbom": "node infra/security/sbom.mjs",
    "security:install-hook": "git config core.hooksPath infra/security/hooks",
    "secret-guard:scan": "tsx --tsconfig tsconfig.test.json tools/repo/secret-guard-scan.ts",
    "dr:backup": "bash infra/dr/backup.sh",
    "dr:restore": "bash infra/dr/restore.sh",
    "dr:verify": "bash infra/dr/verify.sh",
    "dr:drill": "bash infra/dr/drill.sh",
    "dr:status": "bash infra/dr/backup-status.sh",
    "pentest:check": "node infra/pentest/check-threat-model.mjs",
    "conformance": "tsx --tsconfig tsconfig.test.json infra/conformance/conformance.ts",
    "gate:g1": "tsx --tsconfig tsconfig.test.json infra/conformance/gate.ts G1",
    "gate:g2": "tsx --tsconfig tsconfig.test.json infra/conformance/gate.ts G2",
    "gate:g3": "tsx --tsconfig tsconfig.test.json infra/conformance/gate.ts G3",
    "gate:g4": "tsx --tsconfig tsconfig.test.json infra/conformance/gate.ts G4",
    "gate:g5": "tsx --tsconfig tsconfig.test.json infra/conformance/gate.ts G5",
    "gate:g6": "tsx --tsconfig tsconfig.test.json infra/conformance/gate.ts G6",
    "chaos": "bash -c 'CHAOS=1 exec vitest run --config vitest.workspace.ts apps/api/test/chaos \"$@\"' --",
    "loadtest:relay": "bash -c 'ulimit -n 200000; exec tsx --tsconfig tsconfig.test.json infra/loadtest/relay-load.ts \"$@\"' --",
    "capacity:model": "tsx --tsconfig tsconfig.test.json infra/loadtest/capacity.ts",
    "alerts:lint": "tsx --tsconfig tsconfig.test.json infra/alerts/lint.mjs",
    "alerts:test": "node infra/alerts/promtool.mjs",
    "alerts:render": "node infra/alerts/render.mjs",
    "dev:branch-check": "tsx --tsconfig tsconfig.test.json tools/dev/branch-check.ts",
    "dev:full-check": "tsx --tsconfig tsconfig.test.json tools/dev/full-check.ts",
    "dev:worker": "tsx --tsconfig tsconfig.test.json tools/dev/api.ts worker",
    "dev:replay-check": "tsx --tsconfig tsconfig.test.json tools/dev/replay-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  }
}
